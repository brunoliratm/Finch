# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.swp
*~
.idea/
.vscode/

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo

# generated web files and caches
/dist/
/.cache/
/.vite/
/.eslintcache

# Android build files and local configuration
/android/.gradle/
/android/**/build/
/android/local.properties
/android/keystore.properties
/android/capacitor-cordova-android-plugins/
/android/app/release/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/app/src/main/res/xml/config.xml
*.apk
*.aab
*.aar
*.jks
*.keystore
